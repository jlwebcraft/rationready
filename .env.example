# RationReady — Environment Configuration Template
# Copy this file to .env at the repository root (for local web/dev) with appropriate local values.
# NEVER commit real credentials, secret keys, or sensitive data.

# AWS Configuration (not exposed to browser code)
AWS_REGION=ap-south-1

# Shop API Base URL
# - Leave blank to use the built-in local synthetic demonstration fixtures (default local mode).
# - Set this variable to a reachable shop API base URL (e.g. deployed API Gateway HTTP API URL) when a backend is available.
# - Note: A configured but unreachable or failing API displays an error state instead of silently falling back to local data.
VITE_API_URL=

# Amazon Cognito Configuration
VITE_COGNITO_USER_POOL_ID=ap-south-1_MockUserPool
VITE_COGNITO_APP_CLIENT_ID=mockcognitoappclientid0001
VITE_COGNITO_REGION=ap-south-1

# Application Settings
VITE_APP_TITLE=RationReady
VITE_DEFAULT_LOCALITY="Demo Locality A"
