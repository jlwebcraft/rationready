# RationReady — Environment Configuration Template
# Copy this file to .env (for local web/dev) with appropriate local values.
# NEVER commit real credentials, secret keys, or sensitive data.

# AWS Configuration
AWS_REGION=ap-south-1

# API Gateway Endpoint (Local mock or deployed HTTP API URL)
VITE_API_URL=http://localhost:3001

# Amazon Cognito Configuration
VITE_COGNITO_USER_POOL_ID=ap-south-1_MockUserPool
VITE_COGNITO_APP_CLIENT_ID=mockcognitoappclientid0001
VITE_COGNITO_REGION=ap-south-1

# Application Settings
VITE_APP_TITLE=RationReady
VITE_DEFAULT_LOCALITY="Demo Locality A"
